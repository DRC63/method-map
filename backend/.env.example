# Copy to .env for local overrides. All optional.

# SQLAlchemy URL. Defaults to a local SQLite file (methodmap.db) next to the app.
# DATABASE_URL=sqlite:///./methodmap.db

# Comma-separated CORS origins allowed to call the API in local dev.
# CORS_ORIGINS=http://localhost:5173

# Password that unlocks in-app authoring/edit mode. CHANGE THIS before deploying.
# ADMIN_PASSWORD=change-me
